# ============================================================================
# Caddy Configuration for PropVest Backend API
# ============================================================================
#
# Caddy is simpler than Nginx and handles SSL automatically with Let's Encrypt.
# No manual certificate setup needed - Caddy does it all automatically!
#
# FEATURES:
#   - Automatic HTTPS with Let's Encrypt
#   - HTTP to HTTPS redirect (automatic)
#   - Security headers
#   - Gzip compression
#   - WebSocket support
#   - Simple, readable configuration
#
# INSTALLATION:
#   Ubuntu/Debian:
#     sudo apt install -y debian-keyring debian-archive-keyring apt-transport-https
#     curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | sudo gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
#     curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | sudo tee /etc/apt/sources.list.d/caddy-stable.list
#     sudo apt update
#     sudo apt install caddy
#
#   Or download binary: https://caddyserver.com/download
#
# USAGE:
#   1. Update domain name below (api.propvest.com)
#   2. Copy this file to /etc/caddy/Caddyfile
#   3. Run: sudo systemctl restart caddy
#   4. Done! Caddy handles SSL automatically
#
# WHY CADDY OVER NGINX?
#   ✅ Automatic HTTPS (no manual certificate setup)
#   ✅ Simpler configuration
#   ✅ Built-in security best practices
#   ✅ Automatic HTTP/2
#   ✅ Automatic certificate renewal
#   ❌ Less battle-tested than Nginx
#   ❌ Slightly higher memory usage
#
# RECOMMENDATION: Use Caddy for simplicity, Nginx for maximum performance
#
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# Production API Configuration
# ────────────────────────────────────────────────────────────────────────────

api.propvest.com {
    # Caddy automatically:
    # - Obtains SSL certificate from Let's Encrypt
    # - Redirects HTTP to HTTPS
    # - Renews certificates before expiry
    # - Enables HTTP/2
    
    # Security headers
    header {
        # HSTS: Force HTTPS for 1 year
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        
        # Prevent clickjacking
        X-Frame-Options "DENY"
        
        # Prevent MIME-sniffing
        X-Content-Type-Options "nosniff"
        
        # XSS Protection
        X-XSS-Protection "1; mode=block"
        
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        
        # Disable unnecessary features
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        
        # Remove Server header (security by obscurity)
        -Server
    }
    
    # Enable gzip compression
    encode gzip
    
    # Request size limit
    request_body {
        max_size 10MB
    }
    
    # Reverse proxy to Go backend
    reverse_proxy localhost:8081 {
        # Health check
        health_uri /health
        health_interval 10s
        health_timeout 5s
        
        # Preserve original request info
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }
    
    # Logging
    log {
        output file /var/log/caddy/propvest-api.log
        format json
    }
}

# ────────────────────────────────────────────────────────────────────────────
