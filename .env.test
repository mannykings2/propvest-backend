# Test Environment Configuration
# Used for integration tests with docker-compose.test.yml

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=propvest_test
DB_PASSWORD=test_password
DB_NAME=propvest_test
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USER=propvest_test
RABBITMQ_PASSWORD=test_password

# JWT
JWT_SECRET=test_jwt_secret_key_for_integration_tests_only
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# API
PORT=8082
ENV=test

# Wallet Limits (in kobo)
MIN_DEPOSIT_AMOUNT=10000
MAX_DEPOSIT_AMOUNT=100000000
MIN_WITHDRAWAL_AMOUNT=100000
MAX_WITHDRAWAL_AMOUNT=50000000

# External Services (Mock for tests)
PAYSTACK_SECRET_KEY=test_paystack_secret
PAYSTACK_PUBLIC_KEY=test_paystack_public
PAYSTACK_WEBHOOK_SECRET=test_webhook_secret

CLOUDINARY_CLOUD_NAME=test_cloud
CLOUDINARY_API_KEY=test_api_key
CLOUDINARY_API_SECRET=test_api_secret

TERMII_API_KEY=test_termii_key
TERMII_SENDER_ID=PropVest

# Email (Mock for tests)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=test
SMTP_PASSWORD=test
SMTP_FROM_EMAIL=noreply@propvest-test.com
SMTP_FROM_NAME=PropVest Test

# ── Composed URLs ────────────────────────────────────────────────────────────
# config.Config reads DATABASE_URL / REDIS_URL / RABBITMQ_URL; the DB_*,
# REDIS_* and RABBITMQ_* keys above are the parts they are built from.
DATABASE_URL=postgres://propvest_test:test_password@localhost:5433/propvest_test?sslmode=disable
REDIS_URL=redis://localhost:6380/0
RABBITMQ_URL=amqp://propvest_test:test_password@localhost:5673/
