# ═══════════════════════════════════════════════════════════════════════════
# PropVest Backend Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control — it contains secrets.

# ───────────────────────────────────────────────────────────────────────────
# APPLICATION SETTINGS
# ───────────────────────────────────────────────────────────────────────────
# Environment: development | staging | production
APP_ENV=development

# Port the HTTP server listens on
PORT=8080

# Base URL for the application (used in email links, etc.)
BASE_URL=http://localhost:8080

# ───────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database?sslmode=disable
DATABASE_URL=postgres://propvest:password@localhost:5435/propvest?sslmode=disable

# Connection pool settings (optional, defaults are sane)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=15m

# ───────────────────────────────────────────────────────────────────────────
# REDIS CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────
# Redis connection URL for caching, sessions, and rate limiting
REDIS_URL=redis://localhost:6379/0

# ───────────────────────────────────────────────────────────────────────────
# RABBITMQ CONFIGURATION (Message Queue)
# ───────────────────────────────────────────────────────────────────────────
# RabbitMQ connection URL for async job processing (withdrawals, notifications)
# IMPORTANT: This is REQUIRED for withdrawal processing!
# Format: amqp://username:password@host:port/vhost
# If not set, withdrawals will be stuck in "pending" status
RABBITMQ_URL=amqp://propvest:password@localhost:5672/

# ───────────────────────────────────────────────────────────────────────────
# AUTHENTICATION & SECURITY
# ───────────────────────────────────────────────────────────────────────────
# Secret key for signing JWT access tokens
# CRITICAL: Generate a strong random string for production
# This example is a real cryptographically secure random string
# For production, generate your own: openssl rand -base64 64
# OR on Windows PowerShell:
# $bytes = New-Object byte[] 48; [System.Security.Cryptography.RNGCryptoServiceProvider]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)
JWT_SECRET=ub6JS5eOGLXbgcqMnod2Fm1Nwz/E7h+Qc4GnXnGeeuacudq0i73yRyhs1M9EpfTPNIM0F+JbfTRMe8yhccAs7A==

# Secret key for signing refresh tokens (MUST be different from JWT_SECRET)
JWT_REFRESH_SECRET=hNgY1coQ5+GgOnqu6ctVXX9ZBvmA23Qm9i7j5CbzOoL62VFWYjIsdfvYXteho5LbE4TRSx6+3fMlmMI9nzHz/g==

# Token lifetimes
# Access tokens should be short-lived (15m recommended)
ACCESS_TOKEN_TTL=15m

# Refresh tokens can be longer (7-30 days)
REFRESH_TOKEN_TTL=720h

# Bcrypt cost (10-12 recommended, higher = more secure but slower)
# Production: 12, Development: 10 for faster tests
BCRYPT_COST=10

# ───────────────────────────────────────────────────────────────────────────
# CLOUDINARY CONFIGURATION (Image Upload)
# ───────────────────────────────────────────────────────────────────────────
# Cloudinary is used for storing user avatars and property images
# Sign up at: https://cloudinary.com/ (free tier available)
# Get credentials from: Dashboard → Account Details

# Your Cloudinary cloud name (e.g., "propvest-prod")
CLOUDINARY_CLOUD_NAME=your_cloud_name

# API Key (looks like: 123456789012345)
CLOUDINARY_API_KEY=your_api_key

# API Secret (looks like: abcdefghijklmnopqrstuvwxyz1234)
CLOUDINARY_API_SECRET=your_api_secret

# Upload preset (optional, for unsigned uploads)
# Create in: Settings → Upload → Upload presets
# Leave empty if not using unsigned uploads
CLOUDINARY_UPLOAD_PRESET=

# ───────────────────────────────────────────────────────────────────────────
# SMS CONFIGURATION (OTP Verification)
# ───────────────────────────────────────────────────────────────────────────
# SMS provider for sending OTP codes (Twilio, Africa's Talking, Termii, etc.)
# Choose based on your location and pricing

# SMS Provider: twilio | africastalking | termii | mock (for development)
SMS_PROVIDER=mock

# Twilio Configuration (if using Twilio)
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Africa's Talking Configuration (if using Africa's Talking)
# Get from: https://account.africastalking.com/
AFRICASTALKING_USERNAME=your_username
AFRICASTALKING_API_KEY=your_api_key
AFRICASTALKING_SENDER_ID=PROPVEST

# Termii Configuration (if using Termii - Nigerian SMS provider)
# Get from: https://termii.com/
TERMII_API_KEY=your_api_key
TERMII_SENDER_ID=PROPVEST

# ───────────────────────────────────────────────────────────────────────────
# CORS CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Development: http://localhost:5173,http://localhost:3000
# Production: https://propvest.com,https://www.propvest.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# ───────────────────────────────────────────────────────────────────────────
# PAYMENT PROVIDER (Paystack)
# ───────────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# Webhook secret for verifying Paystack callbacks
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here

# ───────────────────────────────────────────────────────────────────────────
# CLOUD STORAGE (Cloudinary)
# ───────────────────────────────────────────────────────────────────────────
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ───────────────────────────────────────────────────────────────────────────
# EMAIL SERVICE (SMTP)
# ───────────────────────────────────────────────────────────────────────────
# SMTP server configuration for sending emails
# Development: Use Mailpit (runs via docker-compose on port 1025)
# Production: Use SendGrid, AWS SES, or similar
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@propvest.com
SMTP_FROM_NAME=PropVest

# Use TLS for SMTP? (true for production, false for Mailpit)
SMTP_USE_TLS=false

# ───────────────────────────────────────────────────────────────────────────
# LOGGING CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────
# Log level: debug | info | warn | error | fatal
LOG_LEVEL=info

# Log format: json | console
# Production: json, Development: console for readability
LOG_FORMAT=console

# ───────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ───────────────────────────────────────────────────────────────────────────
# Requests per minute for anonymous users
RATE_LIMIT_ANONYMOUS=100

# Requests per minute for authenticated users
RATE_LIMIT_AUTHENTICATED=300

# Requests per minute for authentication endpoints (login, register)
RATE_LIMIT_AUTH=10

# ───────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS & TRANSACTION LIMITS
# ───────────────────────────────────────────────────────────────────────────
# Enable email verification requirement
REQUIRE_EMAIL_VERIFICATION=true

# Enable KYC verification requirement for investments
REQUIRE_KYC_FOR_INVESTMENT=false

# Transaction Limits (all amounts in KOBO - 1 Naira = 100 kobo)
# ═════════════════════════════════════════════════════════════
# WHY KOBO? Financial systems NEVER use floats (₦15.50) because of rounding
# errors. Instead, use the smallest currency unit as an integer: 1550 kobo.

# Deposit limits
MIN_DEPOSIT_AMOUNT=10000        # ₦100 minimum deposit
MAX_DEPOSIT_AMOUNT=100000000    # ₦1,000,000 maximum deposit

# Withdrawal limits
MIN_WITHDRAWAL_AMOUNT=50000     # ₦500 minimum withdrawal (covers payment provider fees)
MAX_WITHDRAWAL_AMOUNT=10000000  # ₦100,000 maximum single withdrawal (fraud prevention)

# Investment limits
MIN_INVESTMENT_AMOUNT=100000    # ₦1,000 minimum investment
MAX_INVESTMENT_AMOUNT=50000000  # ₦500,000 maximum investment

# ───────────────────────────────────────────────────────────────────────────
# MONITORING & OBSERVABILITY (Optional, for Production)
# ───────────────────────────────────────────────────────────────────────────
# Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn-here

# Prometheus metrics enabled
# ENABLE_METRICS=true

# OpenTelemetry endpoint
# OTEL_EXPORTER_ENDPOINT=http://localhost:4318

# ═══════════════════════════════════════════════════════════════════════════
# NOTES
# ═══════════════════════════════════════════════════════════════════════════
# 1. Copy this file to .env: cp .env.example .env
# 2. Update all values marked with "your_xxx_here" or "change-in-production"
# 3. Generate secure random secrets for production:
#    openssl rand -base64 64
# 4. Never commit .env to git (already in .gitignore)
# 5. For production, use a secret manager (AWS Secrets Manager, etc.)
# ═══════════════════════════════════════════════════════════════════════════
